<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:maui="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:EsmatPlastic.Shared.ViewModels;assembly=EsmatPlastic.Shared"
             x:Class="EsmatPlastic.Mobile.Views.LoginPage"
             maui:DataType="viewModels:LoginViewModel"
             BackgroundColor="#F1F5F9">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20"
                                 Padding="30"
                                 VerticalOptions="Center">

        <Image Source="logo.png" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center" />

        <Label Text="إسمت بلاستيك"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1E293B"/>

        <Label Text="تسجيل الدخول"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="#64748B"/>

        <Border Padding="0"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 8"
                Background="White">
            <Entry x:Name="UsernameEntry"
                   Text="{Binding Username}"
                   Placeholder="اسم المستخدم"
                   Keyboard="Text"
                   ReturnType="Next"
                   Completed="UsernameEntry_Completed"
                   SemanticProperties.Description="اسم المستخدم"
                   HorizontalTextAlignment="Center" />
        </Border>

        <Border Padding="0"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 8"
                Background="White">
            <Entry x:Name="PasswordEntry"
                   Text="{Binding Password}"
                   Placeholder="كلمة المرور"
                   IsPassword="True"
                   ReturnType="Go"
                   ReturnCommand="{Binding LoginCommand}"
                   SemanticProperties.Description="كلمة المرور"
                   HorizontalTextAlignment="Center" />
        </Border>

        <Button Text="دخول"
                BackgroundColor="#0D9488"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                FontAttributes="Bold"
                Command="{Binding LoginCommand}" />

        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#0D9488" />

        <Label Text="{Binding StatusMessage}"
               HorizontalOptions="Center"
               TextColor="#EF4444"
               HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
