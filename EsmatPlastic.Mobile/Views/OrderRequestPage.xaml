<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EsmatPlastic.Mobile.Views.OrderRequestPage"
             BackgroundColor="#F8FAFC"
             Title="طلب حجز">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Customer Info Card -->
            <Frame CornerRadius="15" Padding="20" HasShadow="True" BorderColor="#E2E8F0">
                <VerticalStackLayout Spacing="15">
                    <Label Text="بيانات العميل" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="اسم العميل" TextColor="#64748B" FontSize="14"/>
                        <Entry Text="{Binding CustomerName}" Placeholder="أدخل اسم العميل..." BackgroundColor="White" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="رقم الهاتف" TextColor="#64748B" FontSize="14"/>
                        <Entry Text="{Binding CustomerPhone}" Placeholder="05xxxxxxxx" Keyboard="Telephone" BackgroundColor="White" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Product Selection -->
            <Frame CornerRadius="15" Padding="20" HasShadow="True" BorderColor="#E2E8F0">
                <VerticalStackLayout Spacing="15">
                    <Label Text="إضافة منتجات" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Picker x:Name="VariantPicker" Title="اختر المنتج..." ItemDisplayBinding="{Binding VariantName}" />
                        <Button Text="إضافة"
                                Clicked="OnAddItemClicked"
                                BackgroundColor="#0D9488"
                                TextColor="White"
                                CornerRadius="8"
                                WidthRequest="80"/>
                    </Grid>

                    <!-- List of added items -->
                    <CollectionView ItemsSource="{Binding SelectedItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Padding="0,10">
                                    <Label Text="{Binding VariantName}" VerticalOptions="Center" FontSize="16" TextColor="#1E293B"/>
                                    <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='الكمية: {0}'}" VerticalOptions="Center" TextColor="#64748B"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Submit Button -->
            <Button Text="تأكيد طلب الحجز"
                    Command="{Binding SubmitCommand}"
                    BackgroundColor="#0D9488"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    CornerRadius="15"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
