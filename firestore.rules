rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasPermission(permission) {
      return signedIn()
        && request.auth.token.permissions is list
        && request.auth.token.permissions.hasAny([permission]);
    }

    function validSyncRecord() {
      return request.resource.data.keys().hasAll(['syncId', 'updatedAt', 'payloadJson', 'references'])
        && request.resource.data.syncId is string
        && request.resource.data.payloadJson is string
        && request.resource.data.references is map
        && request.resource.data.updatedAt is timestamp;
    }

    function canManageOrders() {
      return signedIn() && request.auth.token.appRole in ['Admin', 'Secretary'];
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || hasPermission('Users.View'));
      allow create: if hasPermission('Users.Create') && validSyncRecord();
      allow update: if hasPermission('Users.Edit') && validSyncRecord();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if hasPermission('Products.View') || hasPermission('Stock.View')
        || hasPermission('Reports.View') || canManageOrders();
      allow create: if hasPermission('Products.Create') && validSyncRecord();
      allow update: if hasPermission('Products.Edit') && validSyncRecord();
      allow delete: if hasPermission('Products.Delete');
    }

    match /productVariants/{variantId} {
      allow read: if hasPermission('Products.View') || hasPermission('Stock.View')
        || hasPermission('Reports.View') || canManageOrders();
      allow create: if hasPermission('Products.Create') && validSyncRecord();
      allow update: if hasPermission('Products.Edit') && validSyncRecord();
      allow delete: if hasPermission('Products.Delete');
    }

    match /stockTransactions/{transactionId} {
      allow read: if hasPermission('Stock.View');
      allow create: if (hasPermission('Stock.In') || hasPermission('Stock.Out')) && validSyncRecord()
        && request.resource.data.references.productVariant is string
        && request.resource.data.references.user is string;
      allow update, delete: if false;
    }

    match /permissions/{permissionId} {
      allow read: if hasPermission('Permissions.Manage') || hasPermission('Users.Create') || hasPermission('Users.Edit');
      allow write: if false;
    }

    match /userPermissions/{userPermissionId} {
      allow read: if hasPermission('Users.View') || hasPermission('Users.Edit');
      allow create: if (hasPermission('Users.Create') || hasPermission('Users.Edit')) && validSyncRecord()
        && request.resource.data.references.user is string
        && request.resource.data.references.permission is string;
      allow update: if hasPermission('Users.Edit') && validSyncRecord();
      allow delete: if hasPermission('Users.Edit');
    }

    match /orderRequests/{orderRequestId} {
      allow read: if hasPermission('OrderRequests.View') || canManageOrders();
      allow create: if canManageOrders() && validSyncRecord();
      allow update, delete: if canManageOrders() && validSyncRecord();
    }

    match /orderRequestItems/{itemId} {
      allow read: if hasPermission('OrderRequests.View') || canManageOrders();
      allow create: if canManageOrders() && validSyncRecord()
        && request.resource.data.references.orderRequest is string
        && request.resource.data.references.productVariant is string;
      allow update, delete: if canManageOrders() && validSyncRecord();
    }

    match /userCredentials/{userId} {
      allow read: if false;
      allow create, update: if (hasPermission('Users.Create') || hasPermission('Users.Edit'))
        && request.resource.data.keys().hasOnly(['passwordHash', 'updatedAt'])
        && request.resource.data.passwordHash is string
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /deletedRecords/{recordId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['entityType', 'recordKey', 'deletedAt'])
        && request.resource.data.entityType is string
        && request.resource.data.recordKey is string
        && request.resource.data.deletedAt is timestamp
        && ((request.resource.data.entityType == 'User' && hasPermission('Users.Delete'))
          || (request.resource.data.entityType in ['Product', 'ProductVariant'] && hasPermission('Products.Delete')));
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
