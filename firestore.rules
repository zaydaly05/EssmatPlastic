rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasPermission(permission) {
      return signedIn()
        && request.auth.token.permissions is list
        && request.auth.token.permissions.hasAny([permission]);
    }

    function validSyncRecord() {
      return request.resource.data.keys().hasAll(['syncId', 'updatedAt', 'payloadJson', 'references'])
        && request.resource.data.syncId is string
        && request.resource.data.payloadJson is string
        && request.resource.data.references is map
        && request.resource.data.updatedAt is timestamp;
    }

    function canManageOrders() {
      return signedIn() && request.auth.token.appRole in ['Admin', 'Secretary'];
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || hasPermission('Users.View'));
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if hasPermission('Products.View');
      allow create: if hasPermission('Products.Create') && validSyncRecord();
      allow update: if hasPermission('Products.Edit') && validSyncRecord();
      allow delete: if hasPermission('Products.Delete');
    }

    match /productVariants/{variantId} {
      allow read: if hasPermission('Products.View');
      allow create: if hasPermission('Products.Create') && validSyncRecord();
      allow update: if hasPermission('Products.Edit') && validSyncRecord();
      allow delete: if hasPermission('Products.Delete');
    }

    match /stockTransactions/{transactionId} {
      allow read: if hasPermission('Stock.View');
      allow create: if (hasPermission('Stock.In') || hasPermission('Stock.Out')) && validSyncRecord()
        && request.resource.data.references.productVariant is string
        && request.resource.data.references.user is string;
      allow update, delete: if false;
    }

    match /permissions/{permissionId} {
      allow read: if hasPermission('Permissions.Manage');
      allow write: if false;
    }

    match /userPermissions/{userPermissionId} {
      allow read: if hasPermission('Users.View');
      allow write: if false;
    }

    match /orderRequests/{orderRequestId} {
      allow read: if hasPermission('OrderRequests.View') || canManageOrders();
      allow create: if canManageOrders() && validSyncRecord();
      allow update, delete: if canManageOrders() && validSyncRecord();
    }

    match /orderRequestItems/{itemId} {
      allow read: if hasPermission('OrderRequests.View') || canManageOrders();
      allow create: if canManageOrders() && validSyncRecord()
        && request.resource.data.references.orderRequest is string
        && request.resource.data.references.productVariant is string;
      allow update, delete: if canManageOrders() && validSyncRecord();
    }

    match /userCredentials/{userId} {
      allow read, write: if false;
    }

    match /deletedRecords/{recordId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
