<UserControl x:Class="EsmatPlastic.Desktop.Views.Permissions.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EsmatPlastic.Desktop.Converters">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="PageTitleText" Text="الصلاحيات" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="PageSubtitleText" Text="عرض وتصفية جميع صلاحيات النظام وأقسامها" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Summary Stat Cards -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Permissions Card -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TotalLabel" Text="إجمالي الصلاحيات" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TealBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TotalSubtext" Text="جميع صلاحيات النظام" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Background="{DynamicResource TealSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Active Permissions Card -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ActiveLabel" Text="الصلاحيات النشطة" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock x:Name="ActiveCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ActiveSubtext" Text="مفعلة ومتاحة للاستخدام" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Categories Card -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CategoriesLabel" Text="أقسام الصلاحيات" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock x:Name="CategoriesCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CategoriesSubtext" Text="وحدات وأقسام النظام" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Background="{DynamicResource CanvasBrush}" VerticalAlignment="Top">
                        <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Toolbar / Search / Filter Bar -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox x:Name="SearchInput"
                         Grid.Column="0"
                         Height="38"
                         Margin="0,0,10,0"
                         Tag="بحث باسم الصلاحية أو الوصف..."
                         TextChanged="SearchInput_TextChanged"/>

                <!-- Category Filter -->
                <ComboBox x:Name="CategoryFilter"
                          Grid.Column="1"
                          Height="38"
                          Margin="0,0,10,0"
                          SelectionChanged="CategoryFilter_SelectionChanged"/>

                <!-- Refresh Button -->
                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Content="تحديث"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Height="38"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <!-- Main Permissions Data Card -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="12,16,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header Row -->
                <Grid Grid.Row="0" Margin="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderId" Text="#" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeaderName" Grid.Column="1" Text="اسم الصلاحية" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock x:Name="HeaderCategory" Grid.Column="2" Text="القسم" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock x:Name="HeaderDescription" Grid.Column="3" Text="الوصف" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock x:Name="HeaderStatus" Grid.Column="4" Text="الحالة" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                </Grid>

                <Separator Grid.Row="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,4"/>

                <!-- Permissions List -->
                <ListView Grid.Row="2" x:Name="PermissionsList">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ID -->
                                    <TextBlock Text="{Binding Id}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontWeight="SemiBold"/>

                                    <!-- Code Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TealDarkBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Category Pill -->
                                    <Border Grid.Column="2"
                                            Background="#F1F5F9"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"/>
                                    </Border>

                                    <!-- Description -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Description}"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="4"
                                            Background="{Binding StatusBg}"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State Message -->
                <StackPanel Grid.Row="2"
                            x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EmptyStateText" Text="لم يتم العثور على صلاحيات مطابقة لنتائج البحث" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Text -->
        <TextBlock Grid.Row="7"
                   x:Name="StatusText"
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="12"
                   Margin="4,10,4,0"/>
    </Grid>
</UserControl>
