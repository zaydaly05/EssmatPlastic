<Window x:Class="EsmatPlastic.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إسمت بلاستيك"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="16,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="8,8,8,24">
                    <TextBlock Text="إسمت بلاستيك"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="نظام إدارة المخزون"
                               Foreground="#A9C2C7"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="DashboardButton"
                            Content="لوحة التحكم"
                            Style="{StaticResource NavButton}"
                            Click="DashboardButton_Click"/>
                    <Button x:Name="WarehouseButton"
                            Content="المستودع"
                            Style="{StaticResource NavButton}"
                            Click="WarehouseButton_Click"/>
                    <Button x:Name="ProductsButton"
                            Content="المنتجات"
                            Style="{StaticResource NavButton}"
                            Click="ProductsButton_Click"/>
                    <Button x:Name="ReportsButton"
                            Content="التقارير"
                            Style="{StaticResource NavButton}"
                            Click="ReportsButton_Click"/>
                    <Button x:Name="PermissionsButton"
                            Content="الصلاحيات"
                            Style="{StaticResource NavButton}"
                            Click="PermissionsButton_Click"/>
                    <Button x:Name="UsersButton"
                            Content="المستخدمون"
                            Style="{StaticResource NavButton}"
                            Click="UsersButton_Click"/>
                    <Button x:Name="SettingsButton"
                            Content="الإعدادات"
                            Style="{StaticResource NavButton}"
                            Click="SettingsButton_Click"/>
                </StackPanel>

                <Button Grid.Row="2"
                        Content="تسجيل الخروج"
                        Style="{StaticResource NavButton}"
                        Margin="0,12,0,4"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="مرحباً"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="FullNameText"
                                   Tag="NoTranslate"
                                   Text="المستخدم"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border x:Name="ConnectionStatusBorder"
                                    Background="#E6F4EA"
                                    CornerRadius="16"
                                    Padding="10,4"
                                    Margin="0,0,12,0"
                                    ToolTip="حالة الاتصال وقاعدة البيانات">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConnectionStatusDot"
                                             Width="8"
                                             Height="8"
                                             Fill="#1E8E3E"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ConnectionStatusText"
                                               Text="🟢 Neon Cloud"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1E8E3E"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="ArabicLangButton"
                                    Content="العربية"
                                    Style="{StaticResource LangButton}"
                                    Margin="0,0,8,0"
                                    Click="ArabicLangButton_Click"/>
                            <Button x:Name="EnglishLangButton"
                                    Content="English"
                                    Style="{StaticResource LangButton}"
                                    Click="EnglishLangButton_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="RoleText"
                                   Text="Role"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="نتمنى لك يوماً سعيداً"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22">
                <ContentControl x:Name="MainContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
