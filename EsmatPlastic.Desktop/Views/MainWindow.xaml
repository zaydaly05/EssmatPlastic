<Window x:Class="EsmatPlastic.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إسمت بلاستيك"
        Width="1360"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Background="{DynamicResource CanvasBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            Padding="16,22">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="8,10,8,28">

                    <Border Width="44" Height="44" CornerRadius="13"
                            Background="#0E766E" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="EP" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="AppNameText" Text="إسمت بلاستيك"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="AppTaglineText" Text="نظام إدارة المخزون"
                               Foreground="#B7C9CC"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,0">

                    <Button x:Name="DashboardButton"
                            Content="لوحة التحكم"
                            Style="{StaticResource NavButton}"
                            Click="DashboardButton_Click"/>

                    <Button x:Name="WarehouseButton"
                            Content="المستودع"
                            Style="{StaticResource NavButton}"
                            Click="WarehouseButton_Click"/>

                    <Button x:Name="ProductsButton"
                            Content="المنتجات"
                            Style="{StaticResource NavButton}"
                            Click="ProductsButton_Click"/>

                    <Button x:Name="ReportsButton"
                            Content="التقارير"
                            Style="{StaticResource NavButton}"
                            Click="ReportsButton_Click"/>

                    <Button x:Name="OrderRequestsButton"
                            Content="طلبات الحجز"
                            Style="{StaticResource NavButton}"
                            Click="OrderRequestsButton_Click"/>

                    <Button x:Name="PermissionsButton"
                      Content="الصلاحيات"
                      Click="PermissionsButton_Click"
                      Style="{StaticResource NavButton}"/>

                    <Button x:Name="UsersButton"
                            Content="المستخدمون"
                            Style="{StaticResource NavButton}"
                            Click="UsersButton_Click"/>

                    <Button x:Name="SettingsButton"
                        Content="الإعدادات"
                        Style="{StaticResource NavButton}"
                        Click="SettingsButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <!-- Language Switcher -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <Button x:Name="ArabicLangButton" Content="العربية"
                                Style="{StaticResource NavButton}" Width="80" Margin="5,0"
                                HorizontalContentAlignment="Center" Padding="8,4"
                                Click="ArabicLangButton_Click"/>
                        <Button x:Name="EnglishLangButton" Content="English"
                                Style="{StaticResource NavButton}" Width="80" Margin="5,0"
                                HorizontalContentAlignment="Center" Padding="8,4"
                                Click="EnglishLangButton_Click"/>
                    </StackPanel>

                    <Button x:Name="LogoutButton"
                            Content="تسجيل الخروج"
                            Style="{StaticResource NavButton}"
                            Margin="0,15,0,5"
                            Click="LogoutButton_Click"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- Main -->
        <Grid Grid.Column="1"
              Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- User Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    Padding="20,18"
                    CornerRadius="14">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock x:Name="WelcomeText" Text="مرحباً"
                                   FontSize="16"
                                   Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock x:Name="FullNameText"
                                   Text="المستخدم"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right">

                        <TextBlock x:Name="RoleText"
                                   Text="Role"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="HaveANiceDayText" Text="نتمنى لك يوماً سعيداً"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,0,0"/>

                        <!-- Connection Health Indicator -->
                        <Border x:Name="ConnectionStatusBorder"
                                CornerRadius="10"
                                Padding="8,4"
                                Margin="0,10,0,0"
                                Background="{DynamicResource MutedLightBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionStatusDot"
                                         Width="8" Height="8"
                                         Fill="Gray"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="ConnectionStatusText"
                                           Text="جاري التحقق من الاتصال..."
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>

            </Border>

            <!-- Content -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    Padding="20,0,0,0">

                <ContentControl x:Name="MainContent"/>

            </Border>

        </Grid>

    </Grid>

</Window>
