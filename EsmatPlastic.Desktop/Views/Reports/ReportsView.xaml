<UserControl x:Class="EsmatPlastic.Desktop.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <StackPanel>

                <TextBlock Text="التقارير"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="تقارير حركة المخزون"
                           Foreground="#666666"
                           Margin="0,5,0,0"/>

            </StackPanel>

                <Button x:Name="RefreshButton"
                    Content="⟳  تحديث"
                    Width="110"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="RefreshButton_Click"/>

        </Grid>


        <!-- Statistics -->

        <UniformGrid Grid.Row="2"
                     Columns="4"
                     Margin="0">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="اسم المنتج"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding TotalIn}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="الرصيد الحالي"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding TotalOut}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="إجمالي الوارد"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding CurrentStock}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="8,0,0,0">

                <StackPanel>
                    <TextBlock Text="إجمالي الصادر"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding VariantCount}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

        </UniformGrid>


        <!-- Search -->

        <TextBox Grid.Row="3"
                 Height="40"
                 Padding="10"
                 FontSize="14"
                 Text="{Binding SearchText,
                                UpdateSourceTrigger=PropertyChanged}"/>


        <!-- Report -->

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <ListView ItemsSource="{Binding FilteredItems}"
                      BorderThickness="0">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border Padding="8"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="{Binding ProductName}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding VariantName}"
                                               Foreground="#777777"
                                               FontSize="12"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding TotalIn}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalOut}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding CurrentQuantity}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>


        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   Foreground="#666666"
                   Margin="5,10"/>

    </Grid>

</UserControl>
