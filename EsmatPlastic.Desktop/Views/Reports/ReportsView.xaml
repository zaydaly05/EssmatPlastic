<UserControl x:Class="EsmatPlastic.Desktop.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Reports" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Comprehensive stock movement and balance reports"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExportCsvButton" Content="Export CSV"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="138" Height="44" Margin="0,0,10,0"
                        Click="ExportCsv_Click"/>
                <Button x:Name="PrintReportButton" Content="Print Report"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="156" Height="44" Margin="0,0,10,0"
                        Click="PrintReport_Click"/>
                <Button x:Name="RefreshButton"
                        Content="↻  Refresh"
                        Style="{StaticResource SecondaryButton}"
                        Width="120" Height="44"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total In" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding TotalIn, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="⇩" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Out" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding TotalOut, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="⇧" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Current Balance" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding CurrentStock, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource TealSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="▥" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Variants" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding VariantCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource CanvasBrush}" VerticalAlignment="Center">
                        <TextBlock Text="◇" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10">
            <TextBox Height="42"
                     Padding="12,5"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="12,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Product &amp; Variant" Style="{StaticResource ColumnHeader}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Size" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Total incoming" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Total outgoing" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Available Stock" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Separator Grid.Row="1" Background="{DynamicResource LineBrush}"/>
                <ListView Grid.Row="2" ItemsSource="{Binding FilteredItems}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="62" Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding VariantName}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TotalIn, StringFormat={}{0:N0}}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalOut, StringFormat={}{0:N0}}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Column="4" Background="{DynamicResource TealSoftBrush}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentQuantity, StringFormat={}{0:N0}}" Foreground="{DynamicResource TealDarkBrush}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="7"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MutedBrush}"
                   Margin="4,8,4,0"
                   FontSize="12"/>
    </Grid>
</UserControl>
