<Window x:Class="EsmatPlastic.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Esmat Plastic"
        Width="920"
        Height="580"
        MinWidth="800"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="44" ClipToBounds="True">
                <Ellipse Width="270" Height="270" Fill="#24545B" Opacity="0.38"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-132,0"
                         IsHitTestVisible="False"/>
                <Ellipse Width="190" Height="190" Fill="#0E766E" Opacity="0.22"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-112,0,0,-92"
                         IsHitTestVisible="False"/>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="16" Background="#1C5A63" Margin="0,0,0,22">
                        <TextBlock Text="EP"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="AppNameLabel"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock x:Name="AppTaglineLabel"
                               FontSize="16"
                               Foreground="#C5D9DD"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Simple inventory management for plastic products."
                               FontSize="14"
                               LineHeight="22"
                               Foreground="#B4C8CB"
                               TextWrapping="Wrap"
                               Margin="0,28,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
            <Grid Margin="42,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ArabicLangButton"
                            Content="العربية"
                            Style="{StaticResource LangButton}"
                            Margin="0,0,8,0"
                            Click="ArabicLangButton_Click"/>
                    <Button x:Name="EnglishLangButton"
                            Content="English"
                            Style="{StaticResource LangButton}"
                            Click="EnglishLangButton_Click"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="32"
                        MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="تسجيل الدخول"
                                   Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="اختر اللغة ثم سجّل الدخول للمتابعة."
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="0,8,0,28"/>

                        <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameInput"
                                 Height="44"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="كلمة المرور"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,8"/>
                        <PasswordBox x:Name="PasswordInput"
                                     Height="44"
                                     PasswordChanged="PasswordInput_OnPasswordChanged"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   MinHeight="22"
                                   Margin="0,14,0,0"/>

                        <Button Height="46"
                                Margin="0,10,0,0"
                                Content="تسجيل الدخول"
                                IsDefault="True"
                                Command="{Binding LoginCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
