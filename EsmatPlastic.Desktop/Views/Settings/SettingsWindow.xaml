<Window x:Class="EsmatPlastic.Desktop.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="720"
        Height="620"
        MinWidth="640"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="Configure the application language and preferences."
                       Style="{StaticResource PageSubtitle}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,22,0,22"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Language and preferences"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="Application Language" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="LanguageInput" Height="42" SelectedIndex="0">
                            <ComboBoxItem Content="العربية" Tag="ar"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                        <CheckBox x:Name="RememberLanguageInput"
                                  Content="Remember language when the application starts"
                                  IsChecked="True"
                                  Margin="0,16,0,0"
                                  FontSize="14"/>
                    </StackPanel>
                </Border>

                <Border Background="#F8FAFC"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        Padding="18"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12"
                                Background="{DynamicResource TealSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="EP" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TealDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                        <TextBlock Text="Application Information"
                                       FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Esmat Plastic Desktop"
                                       Margin="0,5,0,0"/>
                            <TextBlock Text="WPF / .NET 9"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="112"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>
            <Button Content="Save"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="124"
                    Height="42"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
