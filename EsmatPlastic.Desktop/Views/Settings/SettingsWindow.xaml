<Window x:Class="EsmatPlastic.Desktop.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعدادات"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="الإعدادات"
                   FontSize="28"
                   FontWeight="Bold"/>


        <TextBlock Grid.Row="2"
                   Text="لغة التطبيق"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="LanguageInput"
                  Grid.Row="3"
                  Height="40"
                  SelectedIndex="0">

            <ComboBoxItem Content="العربية"
                          Tag="ar"/>

            <ComboBoxItem Content="English"
                          Tag="en"/>

        </ComboBox>

        <CheckBox x:Name="RememberLanguageInput"
              Grid.Row="4"
              Content="تذكر اللغة عند تشغيل التطبيق"
              IsChecked="True"
              Margin="0,16,0,0"/>

        <TextBlock Grid.Row="6"
                   Text="عنوان واجهة API"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="ApiInput"
             Grid.Row="7"
                 Height="40"
                 Padding="10"/>


        <Border Grid.Row="8"
                Background="#F5F5F5"
                Padding="15"
                CornerRadius="8">

            <StackPanel>

                <TextBlock Text="معلومات التطبيق"
                           FontWeight="Bold"/>

                <TextBlock Text="Esmat Plastic Desktop"
                           Margin="0,8,0,0"/>

                <TextBlock Text="WPF / .NET 9"
                           Foreground="#666666"/>

            </StackPanel>

        </Border>


        <StackPanel Grid.Row="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="إلغاء"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="حفظ"
                    Width="110"
                    Height="40"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>
