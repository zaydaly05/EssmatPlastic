<Window x:Class="EsmatPlastic.Desktop.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعدادات"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="HeaderTitle"
                           Text="⚙️  الإعدادات العامة"
                           Style="{StaticResource ModalHeader}"/>

                <TextBlock x:Name="HeaderSubtitle"
                           Text="تفضيلات لغة التطبيق وتكوينات اتصال السيرفر"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- Section 1: Language & Preferences -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="LangSectionTitle" Text="🌐  لغة الواجهة والتفضيلات" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>

                    <TextBlock x:Name="LangLabel" Text="لغة التطبيق" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LanguageInput"
                              Height="40"
                              SelectedIndex="0"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="العربية (Arabic)" Tag="ar"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>

                    <CheckBox x:Name="RememberLanguageInput"
                              Content="تذكر اللغة المحددة عند فتح التطبيق دائماً"
                              IsChecked="True"/>
                </StackPanel>
            </Border>

            <!-- Section 2: Server API Connection -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="ApiSectionTitle" Text="🔌  اتصال خادم واجهة البيانات (API)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>

                    <TextBlock x:Name="ApiLabel" Text="عنوان السيرفر (Server API Base URL)" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ApiInput"
                                 Grid.Column="0"
                                 MinHeight="40"
                                 Margin="0,0,8,0"/>

                        <Button x:Name="TestApiButton"
                                Grid.Column="1"
                                Content="فحص الاتصال"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="150"
                                MinHeight="40"
                                Click="TestApiButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="ApiStatusText"
                               Text=""
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="2,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Section 3: System & App Info -->
            <Border Grid.Row="6" Background="#F8FAFC" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="شركة عصمت للبلاستيك - نظام إدارة المخازن" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="Esmat Plastic Desktop Application v1.0.0" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text=".NET 9 WPF" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Buttons Footer -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="إلغاء"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>

                <Button x:Name="SaveButton"
                        Content="حفظ الإعدادات"
                        Style="{StaticResource PrimaryButton}"
                        Width="130"
                        Height="40"
                        IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
