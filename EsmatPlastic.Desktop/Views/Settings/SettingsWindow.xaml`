<Window x:Class="EsmatPlastic.Desktop.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="600"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   FontSize="32"
                   FontWeight="ExtraBold"
                   Foreground="{DynamicResource InkBrush}"
                   Margin="0,0,0,30"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Language Card -->
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#CBD5E1" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="App Language"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}"
                                   Margin="0,0,0,12"/>

                        <ComboBox x:Name="LanguageInput"
                                  Height="40"
                                  SelectedIndex="0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="العربية" Tag="ar"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>

                        <CheckBox x:Name="RememberLanguageInput"
                                  Content="Remember language on startup"
                                  IsChecked="True"
                                  Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- API Card -->
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#CBD5E1" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="API Interface Address"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBox x:Name="ApiInput"
                                 Height="40"
                                 Padding="10"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- App Info Card -->
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="14"
                        Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#CBD5E1" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Application Information"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Esmat Plastic Desktop"
                                   Foreground="{DynamicResource InkBrush}"
                                   FontSize="14"/>

                        <TextBlock Text="WPF / .NET 9"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,30,0,0">

            <Button Content="Cancel"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Width="110"
                    Height="40"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
