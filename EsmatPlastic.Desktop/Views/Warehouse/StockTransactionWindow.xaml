<Window x:Class="EsmatPlastic.Desktop.Views.Warehouse.StockTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حركة مخزون"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="ModalHeaderText"
                       Text="إضافة حركة مخزون"
                       Style="{StaticResource ModalHeader}"/>

            <TextBlock x:Name="ModalSubtitleText"
                       Text="سجّل حركة دخول (وارد) أو خروج (صادر) من المخزن."
                       Style="{StaticResource PageSubtitle}"
                       Margin="0,0,0,20"/>

            <Border Background="#F8FAFC" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="ProductText" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="VariantText" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TransactionTypeLabel" Text="نوع الحركة" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="TransactionTypeInput"
                      Height="40"
                      Margin="0,0,0,14"
                      SelectedIndex="0">
                <ComboBoxItem Content="وارد"/>
                <ComboBoxItem Content="صادر"/>
            </ComboBox>

            <TextBlock x:Name="QuantityLabel" Text="الكمية" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="QuantityInput"
                     Height="40"
                     Margin="0,0,0,14"/>

            <TextBlock x:Name="NotesLabel" Text="الملاحظات" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NotesInput"
                     Height="65"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     Padding="10,8"
                     Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn"
                        Content="إلغاء"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="حفظ الحركة"
                        Style="{StaticResource PrimaryButton}"
                        Width="130"
                        Height="40"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

