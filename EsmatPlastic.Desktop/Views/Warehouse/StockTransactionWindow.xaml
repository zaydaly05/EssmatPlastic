<Window x:Class="EsmatPlastic.Desktop.Views.Warehouse.StockTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حركة مخزون"
        Width="520"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="إضافة حركة مخزون"
                   FontSize="25"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="2"
                   x:Name="ProductText"
                   FontSize="16"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="4"
                   x:Name="VariantText"
                   FontSize="14"
                   Foreground="#666666"/>

        <TextBlock Grid.Row="6"
                   Text="نوع الحركة"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="TransactionTypeInput"
                  Grid.Row="7"
                  Height="40"
                  FontSize="15"
                  SelectedIndex="0">

            <ComboBoxItem Content="وارد"/>
            <ComboBoxItem Content="صادر"/>

        </ComboBox>

        <TextBlock Grid.Row="8"
                   Text="الكمية"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="QuantityInput"
                 Grid.Row="9"
                 Height="40"
                 FontSize="16"
                 Padding="10"/>

        <TextBlock Grid.Row="10"
                   Text="الملاحظات"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="NotesInput"
                 Grid.Row="11"
                 Height="55"
                 FontSize="14"
                 Padding="10"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"/>

        <StackPanel Grid.Row="12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="إلغاء"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="حفظ الحركة"
                    Width="130"
                    Height="40"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
