<Window x:Class="EsmatPlastic.Desktop.Views.Warehouse.StockHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل حركات المخزون"
        Width="950"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Background="{DynamicResource CanvasBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="سجل حركات المخزون"
                       Style="{StaticResource ModalHeader}"/>

            <TextBlock x:Name="VariantText"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="8,16,8,8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="التاريخ" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock Grid.Column="1" Text="النوع" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="الكمية" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="المستخدم" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock Grid.Column="4" Text="الملاحظات" Style="{StaticResource ColumnHeader}"/>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding Transactions}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12"/>

                                    <Border Grid.Column="1"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="In">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="صادر"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="In">
                                                            <Setter Property="Text" Value="وارد"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Quantity}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding FullName}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Notes}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="إغلاق"
                    Style="{StaticResource SecondaryButton}"
                    Width="100"
                    Height="38"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>


