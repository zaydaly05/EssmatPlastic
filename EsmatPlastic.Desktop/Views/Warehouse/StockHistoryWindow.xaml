<Window x:Class="EsmatPlastic.Desktop.Views.Warehouse.StockHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل حركات المخزون"
        Width="950"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">

            <TextBlock Text="سجل حركات المخزون"
                       FontSize="25"
                       FontWeight="Bold"/>

            <TextBlock x:Name="VariantText"
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0"
                      Margin="5,0,5,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="التاريخ"
                               FontWeight="Bold"/>

                    <TextBlock Grid.Column="1"
                               Text="النوع"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="الكمية"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="3"
                               Text="الملاحظات"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="4"
                               Text="المستخدم"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </Grid>


                <ListView Grid.Row="1"
                          ItemsSource="{Binding Transactions}"
                          BorderThickness="0">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Padding="8"
                                    Margin="0,3"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding CreatedAt}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text"
                                                        Value="وارد"/>

                                                <Setter Property="Foreground"
                                                        Value="Red"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="In">

                                                        <Setter Property="Text"
                                                                Value="صادر"/>

                                                        <Setter Property="Foreground"
                                                                Value="Green"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Quantity}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding FullName}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Notes}"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

    </Grid>

</Window>

