<UserControl x:Class="EsmatPlastic.Desktop.Views.Warehouse.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="المستودع"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="إدارة المخزون وحركات المنتجات"
                           FontSize="14"
                           Foreground="#666666"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Content="⟳  تحديث"
                    Width="110"
                    Height="40"
                    Click="RefreshButton_Click"/>

        </Grid>


        <!-- Search -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchInput"
                     Height="40"
                     FontSize="15"
                     Padding="10"
                     Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="أرصدة المنتجات في المستودع"
                       Foreground="#999999"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

        </Grid>


        <!-- Stock Table -->

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Header -->

                <Grid Grid.Row="0"
                      Margin="5,0,5,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="المنتج"
                               FontWeight="Bold"/>

                    <TextBlock Grid.Column="1"
                               Text="الصنف"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="المتاح"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="3"
                               Text="الوارد"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="4"
                               Text="الصادر"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </Grid>


                <!-- Items -->

                <ListView Grid.Row="1"
                          ItemsSource="{Binding FilteredStockItems}"
                          SelectedItem="{Binding SelectedStock, Mode=TwoWay}"
                          BorderThickness="0">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Padding="8"
                                    Margin="0,3"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding VariantName}"
                                                   FontSize="12"
                                                   Foreground="#777777"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>


                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Size}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>


                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalIn}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>


                                    <TextBlock Grid.Column="3"
                                               Text="{Binding TotalOut}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>


                                    <TextBlock Grid.Column="4"
                                               Text="{Binding CurrentQuantity}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>


        <!-- Footer -->

        <Grid Grid.Row="5"
              Margin="5,12,5,0">

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#666666"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="InButton"
                        Content="+ وارد"
                        Width="110"
                        Height="40"
                        Margin="0,0,8,0"
                        Click="InButton_Click"/>

                <Button x:Name="OutButton"
                        Content="- صادر"
                        Width="110"
                        Height="40"
                        Margin="0,0,8,0"
                        Click="OutButton_Click"/>

                <Button x:Name="HistoryButton"
                        Content="سجل الحركات"
                        Width="125"
                        Height="40"
                        Click="HistoryButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
