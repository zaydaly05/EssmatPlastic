<UserControl x:Class="EsmatPlastic.Desktop.Views.Warehouse.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="المستودع" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="إدارة المخزون وحركات المنتجات" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Button x:Name="RefreshButton"
                    Content="⟳  تحديث"
                    Style="{StaticResource SecondaryButton}"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="RefreshButton_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <TextBox x:Name="SearchInput"
                     Height="42"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="أرصدة المنتجات في المستودع"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="14,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8,16,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="المنتج" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock Grid.Column="1" Text="المقاس" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="الوارد" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="الصادر" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="المتاح" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding FilteredStockItems}"
                          SelectedItem="{Binding SelectedStock, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ProductName, Converter={StaticResource TranslateConverter}}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding VariantName, Converter={StaticResource TranslateConverter}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource TranslateConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalIn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalOut}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding CurrentQuantity}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="4,14,4,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InButton"
                        Content="+ وارد"
                        Width="118"
                        Height="40"
                        Margin="0,0,8,0"
                        Click="InButton_Click"/>
                <Button x:Name="OutButton"
                        Content="- صادر"
                        Style="{StaticResource DangerButton}"
                        Width="118"
                        Height="40"
                        Margin="0,0,8,0"
                        Click="OutButton_Click"/>
                <Button x:Name="HistoryButton"
                        Content="سجل الحركات"
                        Style="{StaticResource SecondaryButton}"
                        Width="130"
                        Height="40"
                        Click="HistoryButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
