<UserControl x:Class="EsmatPlastic.Desktop.Views.ProductVariants.ProductVariantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="أصناف المنتج" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="ProductNameText"
                           Tag="NoTranslate"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Button x:Name="AddButton"
                    Content="+  إضافة صنف"
                    Width="150"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="AddButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,16,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="اسم الصنف" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock Grid.Column="1" Text="المقاس" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="اللون" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="الغطاء" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="المادة" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="الحالة" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Variants}"
                          SelectedItem="{Binding SelectedVariant, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource TranslateConverter}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource TranslateConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Color, Converter={StaticResource TranslateConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CapType, Converter={StaticResource TranslateConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Material, Converter={StaticResource TranslateConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="4,14,4,0">
            <TextBlock x:Name="StatusText"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EditButton"
                        Content="تعديل"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="115"
                        MinHeight="38"
                        Margin="0,0,8,0"
                        Click="EditButton_Click"/>
                <Button x:Name="DeleteButton"
                        Content="حذف"
                        Style="{StaticResource DangerButton}"
                        MinWidth="115"
                        MinHeight="38"
                        Click="DeleteButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
