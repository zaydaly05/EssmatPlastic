<Window x:Class="EsmatPlastic.Desktop.Views.ProductVariants.EditProductVariantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الصنف"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Border Padding="28">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="تعديل الصنف"
                           Style="{StaticResource ModalHeader}"/>

                <TextBlock Text="تعديل بيانات العبوة أو تعديل حالة التفعيل."
                           Style="{StaticResource PageSubtitle}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="اسم الصنف" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameInput"
                         Height="40"
                         Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="المقاس" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SizeInput" Height="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="اللون" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ColorInput" Height="40"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="نوع الغطاء" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CapTypeInput" Height="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="المادة" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MaterialInput" Height="40"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ActiveInput"
                          Content="نشط حالياً"
                          IsChecked="True"
                          Margin="0,0,0,24"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="إلغاء"
                            Style="{StaticResource SecondaryButton}"
                            Width="100"
                            Height="40"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>

                    <Button x:Name="SaveButton"
                            Content="حفظ"
                            Style="{StaticResource PrimaryButton}"
                            Width="120"
                            Height="40"
                            IsDefault="True"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
