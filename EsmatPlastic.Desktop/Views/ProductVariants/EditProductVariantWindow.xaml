<Window x:Class="EsmatPlastic.Desktop.Views.ProductVariants.EditProductVariantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الصنف"
        Width="600"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="تعديل الصنف"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Grid.Row="2"
                       Text="اسم الصنف"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="NameInput"
                     Grid.Row="4"
                     Height="40"
                     FontSize="15"
                     Padding="10"/>

            <TextBlock Grid.Row="6"
                       Text="المقاس"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="SizeInput"
                     Grid.Row="8"
                     Height="40"
                     FontSize="15"
                     Padding="10"/>

            <TextBlock Grid.Row="10"
                       Text="اللون"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="ColorInput"
                     Grid.Row="12"
                     Height="40"
                     FontSize="15"
                     Padding="10"/>

            <TextBlock Grid.Row="14"
                       Text="نوع الغطاء"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="CapTypeInput"
                     Grid.Row="16"
                     Height="40"
                     FontSize="15"
                     Padding="10"/>

            <TextBlock Grid.Row="18"
                       Text="المادة"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="MaterialInput"
                     Grid.Row="20"
                     Height="40"
                     FontSize="15"
                     Padding="10"/>

            <CheckBox x:Name="ActiveInput"
                      Grid.Row="22"
                      Content="نشط حالياً"
                      FontSize="15"
                      IsChecked="True"/>

            <StackPanel Grid.Row="24"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="إلغاء"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button Content="حفظ"
                        Width="120"
                        Height="40"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>
