<Window x:Class="EsmatPlastic.Desktop.Views.Products.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل المنتج"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="ModalTitle" Text="تعديل بيانات المنتج"
                       Style="{StaticResource ModalHeader}"/>

            <TextBlock x:Name="ModalSubtitle" Text="قم بتحديث معلومات المنتج أو صورته أو حالته."
                       Style="{StaticResource PageSubtitle}"
                       Margin="0,0,0,24"/>

            <!-- Photo Upload Area -->
            <TextBlock x:Name="PhotoLabel" Text="صورة المنتج" Style="{StaticResource FieldLabel}"/>
            <Border Background="#F8FAFC" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="10" Background="#E2E8F0" Margin="0,0,14,0" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="ImagePlaceholder" Text="📷" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PhotoPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="SelectPhotoButton"
                                Content="🖼️  تغيير صورة المنتج"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Height="36"
                                Click="SelectPhotoButton_Click"/>
                        <TextBlock x:Name="PhotoPathText" Text="صورة المنتجات الحالية" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="NameLabel" Text="اسم المنتج" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameInput"
                     Height="40"
                     Margin="0,0,0,16"/>

            <TextBlock x:Name="DescLabel" Text="الوصف" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DescriptionInput"
                     Height="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     Padding="10,8"
                     Margin="0,0,0,16"/>

            <CheckBox x:Name="ActiveInput"
                      Content="نشط حالياً"
                      IsChecked="True"
                      Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="إلغاء"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="115"
                        MinHeight="40"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="حفظ"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="130"
                        MinHeight="40"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
