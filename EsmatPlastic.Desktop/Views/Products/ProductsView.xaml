<UserControl x:Class="EsmatPlastic.Desktop.Views.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock x:Name="PageTitleText" Text="المنتجات" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="PageSubtitleText" Text="إدارة المنتجات والأصناف والبطاقات" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Button x:Name="AddButton"
                    Content="+  إضافة منتج"
                    Style="{StaticResource PrimaryButton}"
                    Width="160"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="AddButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,16,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderPhoto" Text="الصورة" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeaderProduct" Grid.Column="1" Text="المنتج والوصف" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock x:Name="HeaderVariants" Grid.Column="2" Text="عدد الأصناف" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeaderStatus" Grid.Column="3" Text="الحالة" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeaderActions" Grid.Column="4" Text="الإجراءات" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
                </Grid>

                <Separator Grid.Row="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,4"/>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Product Image Thumbnail (Clickable to Edit/Upload Photo) -->
                                    <Border Grid.Column="0"
                                            Width="46"
                                            Height="46"
                                            CornerRadius="10"
                                            Background="#F1F5F9"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            ToolTip="انقر لتعديل/رفع صورة للمنتج"
                                            MouseLeftButtonUp="PhotoThumbnail_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <!-- Product Name & Description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Variant Count -->
                                    <Border Grid.Column="2"
                                            Background="#F8FAFC"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VariantCount, Converter={StaticResource UnitFormatConverter}, ConverterParameter=Variant}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"/>
                                    </Border>

                                    <!-- Active Status Badge -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="12"/>

                                    <!-- View Variants Button -->
                                    <Button Grid.Column="4"
                                            Content="عرض الأصناف"
                                            Style="{StaticResource SecondaryButton}"
                                            MinWidth="135"
                                            MinHeight="36"
                                            HorizontalAlignment="Center"
                                            Click="VariantsButton_Click"
                                            Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Admin Action Buttons & Status Footer -->
        <Grid Grid.Row="3" Margin="4,14,4,0">
            <TextBlock x:Name="StatusText"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EditButton"
                        Content="تعديل المنتج"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="135"
                        MinHeight="38"
                        Margin="0,0,8,0"
                        Click="EditButton_Click"/>
                <Button x:Name="DeleteButton"
                        Content="حذف المنتج"
                        Style="{StaticResource DangerButton}"
                        MinWidth="135"
                        MinHeight="38"
                        Click="DeleteButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
