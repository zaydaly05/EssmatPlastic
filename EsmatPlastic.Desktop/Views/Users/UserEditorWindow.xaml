<Window x:Class="EsmatPlastic.Desktop.Views.Users.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مستخدم"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer>

        <StackPanel Margin="30">

            <TextBlock Text="بيانات المستخدم"
                       FontSize="25"
                       FontWeight="Bold"/>

            <TextBlock Text="اسم المستخدم"
                       Margin="0,25,0,5"/>

            <TextBox x:Name="UsernameInput"
                     Height="40"
                     Padding="10"/>

            <TextBlock Text="الاسم الكامل"
                       Margin="0,15,0,5"/>

            <TextBox x:Name="FullNameInput"
                     Height="40"
                     Padding="10"/>

            <TextBlock Text="الدور"
                       Margin="0,15,0,5"/>

            <PasswordBox x:Name="PasswordInput"
                         Height="40"
                         Padding="10"/>

            <TextBlock Text="الحالة"
                       Margin="0,15,0,5"/>

            <ComboBox x:Name="RoleInput"
                      Height="40"
                      FontSize="14"/>

            <CheckBox x:Name="ActiveInput"
                      Content="نشط حالياً"
                      IsChecked="True"
                      Margin="0,15,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,30,0,0">

                <Button Content="إلغاء"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="حفظ"
                        Width="110"
                        Height="40"
                        Click="Save_Click"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Window>
