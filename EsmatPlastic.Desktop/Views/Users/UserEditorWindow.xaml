<Window x:Class="EsmatPlastic.Desktop.Views.Users.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مستخدم"
        Width="540"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="HeaderTitle"
                           Text="بيانات المستخدم"
                           Style="{StaticResource ModalHeader}"/>

                <TextBlock Text="أدخل بيانات حساب المستخدم والدور والصلاحيات."
                           Style="{StaticResource PageSubtitle}"
                           Margin="0,0,0,16"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameInput"
                             Height="40"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="الاسم الكامل" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FullNameInput"
                             Height="40"
                             Margin="0,0,0,14"/>

                    <StackPanel x:Name="PasswordPanel" Margin="0,0,0,14">
                        <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordInput" Height="40"/>
                    </StackPanel>

                    <TextBlock Text="الدور" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="RoleInput"
                              Height="40"
                              Margin="0,0,0,14"/>

                    <CheckBox x:Name="ActiveInput"
                              Content="نشط حالياً"
                              IsChecked="True"
                              Margin="0,0,0,16"/>

                    <TextBlock Text="صلاحيات المستخدم" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource Card}" Padding="8,8" Margin="0,0,0,8" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PermissionsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="#FAFAFA">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>

                <Button x:Name="SaveButton"
                        Content="حفظ"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"
                        Height="40"
                        IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

