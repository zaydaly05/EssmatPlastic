<UserControl x:Class="EsmatPlastic.Desktop.Views.Users.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <StackPanel>

                <TextBlock Text="المستخدمون"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="إدارة المستخدمين والصلاحيات"
                           Foreground="#666666"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Content="+ إضافة مستخدم"
                    Width="130"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="AddButton_Click"/>

        </Grid>


        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <ListView x:Name="UsersList"
                      SelectedValuePath="Id"
                      BorderThickness="0">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border Padding="8"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="{Binding FullName}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding Username}"
                                               Foreground="#777777"
                                               FontSize="12"/>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding RoleName}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding StatusName}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding CreatedAt}"
                                           HorizontalAlignment="Center"
                                           FontSize="11"/>

                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <Button Content="تعديل"
                                            Width="75"
                                            Height="34"
                                            Margin="0,0,6,0"
                                            Click="EditButton_Click"/>

                                    <Button Content="تغيير كلمة المرور"
                                            Width="100"
                                            Height="34"
                                            Margin="0,0,6,0"
                                            Click="PasswordButton_Click"/>

                                    <Button Content="حذف"
                                            Width="65"
                                            Height="34"
                                            Click="DeleteButton_Click"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>


        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Foreground="#666666"
                   Margin="5,10"/>

    </Grid>

</UserControl>
