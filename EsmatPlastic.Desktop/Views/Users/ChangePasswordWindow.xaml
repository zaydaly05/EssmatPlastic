<Window x:Class="EsmatPlastic.Desktop.Views.Users.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="تغيير كلمة المرور"
                       Style="{StaticResource ModalHeader}"/>

            <TextBlock Text="أدخل كلمة المرور الجديدة للمستخدم."
                       Style="{StaticResource PageSubtitle}"
                       Margin="0,0,0,20"/>

            <Border Background="#F8FAFC" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم المستخدم" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="UsernameText" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="الاسم الكامل" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="FullNameText" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPasswordBox"
                         Height="40"
                         Margin="0,0,0,14"/>

            <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="40"
                         Margin="0,0,0,14"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="حفظ"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"
                        Height="40"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

