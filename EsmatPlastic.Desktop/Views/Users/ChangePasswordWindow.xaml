<Window x:Class="EsmatPlastic.Desktop.Views.Users.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور"
        Width="450"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="تغيير كلمة المرور"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock Text="اسم المستخدم"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="UsernameText"
                       FontSize="15"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,15">

            <TextBlock Text="الاسم الكامل"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="FullNameText"
                       FontSize="15"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,15">

            <TextBlock Text="كلمة المرور الجديدة"
                       FontWeight="SemiBold"/>

            <PasswordBox x:Name="NewPasswordBox"
                         Height="35"
                         Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,0,0,10">

            <TextBlock Text="تأكيد كلمة المرور"
                       FontWeight="SemiBold"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="35"
                         Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   x:Name="ErrorText"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <Button Content="حفظ"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>

            <Button Content="إلغاء"
                    Width="100"
                    Height="38"
                    Click="CancelButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
