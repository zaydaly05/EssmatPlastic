<Window x:Class="EsmatPlastic.Desktop.Views.Users.UserPermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة صلاحيات المستخدم"
        Width="580"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="إدارة صلاحيات المستخدم"
                           Style="{StaticResource ModalHeader}"/>
                <TextBlock Text="حدد الصلاحيات الممنوحة لهذا المستخدم في النظام."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- User Summary Card -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="FullNameText" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="UsernameText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource TealSoftBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="RoleText" Foreground="{DynamicResource TealDarkBrush}" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Quick Selection Toolbar -->
            <Grid Grid.Row="3">
                <TextBlock Text="قائمة الصلاحيات" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SelectAllButton"
                            Content="تحديد الكل"
                            Style="{StaticResource SecondaryButton}"
                            Height="30"
                            Padding="10,0"
                            FontSize="12"
                            Margin="0,0,6,0"
                            Click="SelectAllButton_Click"/>
                    <Button x:Name="ClearAllButton"
                            Content="إلغاء التحديد"
                            Style="{StaticResource SecondaryButton}"
                            Height="30"
                            Padding="10,0"
                            FontSize="12"
                            Click="ClearAllButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Permissions List -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PermissionsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="#FAFAFA">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Actions Footer -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="حفظ الصلاحيات"
                        Style="{StaticResource PrimaryButton}"
                        Width="140"
                        Height="40"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
