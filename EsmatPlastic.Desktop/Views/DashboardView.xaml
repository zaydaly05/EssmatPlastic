<UserControl x:Class="EsmatPlastic.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Stat Card Base Style with Smooth Hover Lift -->
        <Style x:Key="ModernStatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#64748B" Opacity="0.07"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Horizontal Bar Style -->
        <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- 0: Header & Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Spacing -->
            <RowDefinition Height="16"/>
            <!-- 2: Loading Indicator -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Stat KPI Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Spacing -->
            <RowDefinition Height="18"/>
            <!-- 5: Main Content (Charts & Table) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0: Header & Action Bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#E6FFFA" Margin="0,0,10,0">
                        <!-- Dashboard Grid Icon -->
                        <Path Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M14,14 L21,14 L21,21 L14,21 Z M3,14 L10,14 L10,21 L3,21 Z"
                              Fill="#0D9488" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="لوحة التحكم الرئيسية" FontSize="26" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="مراقبة حركات التوريد والصرف، مؤشرات المخزون، والتنبيهات الفورية" FontSize="13" Foreground="#64748B" Margin="44,4,0,0"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status Badge -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LastUpdatedText" Text="محدث الآن" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button x:Name="RefreshButton" Click="Refresh_Click"
                        Width="120" Height="40" Cursor="Hand" Background="#0E766E" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 L17.65,6.35 Z"
                                          Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBd" Property="Background" Value="#115E59"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBd" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    تحديث
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2: Loading Indicator Bar -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Background="Transparent" Foreground="#0D9488" BorderThickness="0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>

        <!-- 3: Stat KPI Cards -->
        <UniformGrid Grid.Row="3" Rows="1">

            <!-- Card 1: Products -->
            <Border x:Name="ProductsCard" Style="{StaticResource ModernStatCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="المنتجات" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#CCFBF1">
                        <!-- Box Icon -->
                        <Path Data="M12,2 L2,7 L12,12 L22,7 L12,2 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12"
                              Stroke="#0F766E" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ProductCount}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" Foreground="#0F172A" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="منتج رئيسي مسجل" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Card 2: Variants -->
            <Border x:Name="VariantsCard" Style="{StaticResource ModernStatCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="الأصناف والمقاسات" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#E0E7FF">
                        <!-- Layers Icon -->
                        <Path Data="M12,2 L2,7 L12,12 L22,7 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17"
                              Stroke="#4338CA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding VariantCount}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" Foreground="#0F172A" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="صنف فعال متوفر" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Card 3: Current Stock -->
            <Border x:Name="StockCard" Style="{StaticResource ModernStatCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="المخزون الحالي" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#E0F2FE">
                        <!-- Warehouse Icon -->
                        <Path Data="M3,21 L21,21 M3,10 L12,3 L21,10 M5,10 L5,21 M19,10 L19,21 M9,21 L9,14 L15,14 L15,21"
                              Stroke="#0369A1" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding CurrentStock, StringFormat={}{0:N0}}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" Foreground="#0284C7" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="إجمالي الوحدات بالمستودع" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Card 4: Total In -->
            <Border x:Name="TotalInCard" Style="{StaticResource ModernStatCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي الوارد" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#DCFCE7">
                        <!-- Download / Arrow In Icon -->
                        <Path Data="M12,3 L12,15 M12,15 L7,10 M12,15 L17,10 M3,18 L3,21 L21,21 L21,18"
                              Stroke="#15803D" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TotalIn, StringFormat={}{0:N0}}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" Foreground="#16A34A" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="وحدة مستلمة ومدخلة" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Card 5: Total Out -->
            <Border x:Name="TotalOutCard" Style="{StaticResource ModernStatCard}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي الصادر" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#FFEDD5">
                        <!-- Upload / Arrow Out Icon -->
                        <Path Data="M12,15 L12,3 M12,3 L7,8 M12,3 L17,8 M3,18 L3,21 L21,21 L21,18"
                              Stroke="#C2410C" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TotalOut, StringFormat={}{0:N0}}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" Foreground="#EA580C" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="وحدة تم صرفها وشحنها" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                </Grid>
            </Border>

        </UniformGrid>

        <!-- No Permissions Fallback Message -->
        <Border x:Name="NoPermissionsPanel" Grid.Row="3" Background="#FFFBEB" BorderBrush="#FDE68A"
                BorderThickness="1" CornerRadius="14" Padding="28,24" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" Background="#FEF3C7" Margin="0,0,16,0">
                    <Path Data="M12,17 C12.8284271,17 13.5,16.3284271 13.5,15.5 C13.5,14.6715729 12.8284271,14 12,14 C11.1715729,14 10.5,14.6715729 10.5,15.5 C10.5,16.3284271 11.1715729,17 12,17 Z M17,8 L17,6 C17,3.23857625 14.7614237,1 12,1 C9.23857625,1 7,3.23857625 7,6 L7,8 L5,8 C3.8954305,8 3,8.8954305 3,10 L3,20 C3,21.1045695 3.8954305,22 5,22 L19,22 C20.1045695,22 21,21.1045695 21,20 L21,10 C21,8.8954305 20.1045695,8 19,8 L17,8 Z M9,6 C9,4.34314575 10.3431458,3 12,3 C13.6568542,3 15,4.34314575 15,6 L15,8 L9,8 L9,6 Z"
                          Fill="#D97706" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="لا توجد صلاحيات لعرض بطاقات لوحة التحكم" FontSize="16" FontWeight="Bold" Foreground="#92400E" />
                    <TextBlock Text="حسابك الحالي لا يمتلك صلاحية المنتجات أو المخزون. يرجى التواصل مع مسؤول النظام." Margin="0,4,0,0" Foreground="#B45309" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 5: Main Content (Scrollable Grid) -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- Mid Row: Weekly Movement + Health & Alerts -->
                    <RowDefinition Height="Auto" />
                    <!-- Spacing -->
                    <RowDefinition Height="18" />
                    <!-- Bottom Row: Recent Transactions Table -->
                    <RowDefinition Height="Auto" MinHeight="340" />
                </Grid.RowDefinitions>

                <!-- ============================================== -->
                <!-- LEFT PANEL: WEEKLY STOCK MOVEMENT              -->
                <!-- ============================================== -->
                <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#64748B" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header & Legend -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="حركة المخزون الأسبوعية" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="مقارنة الكميات الواردة والصادرة خلال آخر 7 أيام" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Legend -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#0D9488" Margin="0,0,6,0"/>
                                        <TextBlock Text="وارد (In)" FontSize="11" FontWeight="SemiBold" Foreground="#0F766E"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,6,0"/>
                                        <TextBlock Text="صادر (Out)" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#F1F5F9" Height="1" Margin="0,16,0,16"/>

                        <!-- 7 Days Activity Rows -->
                        <ItemsControl ItemsSource="{Binding WeeklyMovement}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#EEF2F6" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Day Name Chip -->
                                            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="6,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DayLabel}" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Visual Dual Bars -->
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Inbound Bar -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="75"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Value="{Binding IncomingPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource RoundedProgressBar}" Foreground="#0D9488" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Incoming, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Outbound Bar -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="75"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Value="{Binding OutgoingPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource RoundedProgressBar}" Foreground="#F97316" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Outgoing, StringFormat={}{0:N0}}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#C2410C" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================================== -->
                <!-- RIGHT PANEL: INVENTORY HEALTH & ALERTS         -->
                <!-- ============================================== -->
                <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#64748B" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Health Title -->
                        <TextBlock Text="حالة المخزون والتنبيهات" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="مؤشر توفر الأصناف وتنبيهات مستويات الأمان" FontSize="12" Foreground="#64748B" Margin="0,3,0,16" />

                        <!-- Health Score Banner Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نسبة توفر الأصناف الآمنة" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                                        <TextBlock Text="{Binding StockHealthPercent, StringFormat={}{0:N0}%, Mode=OneWay}" FontSize="28" FontWeight="ExtraBold" Foreground="#0D9488" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="16" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="مستوى آمن" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                    </Border>
                                </Grid>
                                <ProgressBar Value="{Binding StockHealthPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource RoundedProgressBar}" Height="8" Foreground="#0D9488" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Alerts Section Header -->
                        <Grid Margin="0,20,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تنبيهات المخزون المنخفض" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} تنبيه}" FontSize="11" Foreground="#B91C1C" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <!-- Low Stock Items List -->
                        <ItemsControl ItemsSource="{Binding LowStockItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Alert Icon -->
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="#FFE4E6" Margin="0,0,10,0">
                                                <Path Data="M12,2 L1,21 L23,21 L12,2 Z M12,6 L19.5,19 L4.5,19 L12,6 Z M11,10 L13,10 L13,14 L11,14 Z M11,16 L13,16 L13,18 L11,18 Z"
                                                      Fill="#E11D48" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Product info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="Bold" Foreground="#881337" />
                                                <TextBlock Text="{Binding VariantName}" FontSize="11" Foreground="#9F1239" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Current Quantity Badge -->
                                            <Border Grid.Column="2" Background="#F43F5E" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentQuantity, StringFormat={}متبقي {0:N0} فقط}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State (No Alerts) -->
                        <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLowStockAlerts}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"
                                      Fill="#16A34A" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="المخزون ممتاز - لا توجد أصناف تحت حد الأمان" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============================================== -->
                <!-- BOTTOM PANEL: RECENT TRANSACTIONS TABLE        -->
                <!-- ============================================== -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#64748B" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="أحدث حركات المخزون" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="سجل تفصيلي لآخر العمليات المنفذة على المستودع" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="آخر 8 عمليات مسجلة" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                            </Border>
                        </Grid>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding RecentTransactions}" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="44" MinHeight="260" Background="Transparent" BorderThickness="0"
                                  HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="Transparent">
                            <DataGrid.Columns>

                                <!-- Column 1: Time & Date -->
                                <DataGridTemplateColumn Header="التاريخ والوقت" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M11.99,2 C6.47,2 2,6.48 2,12 C2,17.52 6.47,22 11.99,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 11.99,2 Z M12,20 C7.58,20 4,16.42 4,12 C4,7.58 7.58,4 12,4 C16.42,4 20,7.58 20,12 C20,16.42 16.42,20 12,20 Z M12.5,7 L11,7 L11,13 L16.25,16.15 L17,14.92 L12.5,12.25 L12.5,7 Z"
                                                      Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy  HH:mm}}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Column 2: Movement Type Badge -->
                                <DataGridTemplateColumn Header="نوع الحركة" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TransactionTypeBg}" BorderBrush="{Binding TransactionTypeColor}" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TransactionTypeText}" FontSize="12" FontWeight="Bold" Foreground="{Binding TransactionTypeColor}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Column 3: Product Name -->
                                <DataGridTemplateColumn Header="المنتج" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Column 4: Variant Name -->
                                <DataGridTemplateColumn Header="الصنف / المتغير" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VariantName}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Column 5: Quantity -->
                                <DataGridTemplateColumn Header="الكمية" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" FontSize="14" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                <TextBlock Text=" وحدة" FontSize="11" Foreground="#94A3B8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Column 6: User -->
                                <DataGridTemplateColumn Header="المستخدم المسؤول" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#E2E8F0" Margin="0,0,8,0">
                                                    <!-- Person Icon -->
                                                    <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z"
                                                          Fill="#64748B" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding UserFullName}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State for Transactions -->
                        <Border Grid.Row="2" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentTransactions}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Path Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M19,19 L5,19 L5,5 L19,5 L19,19 Z"
                                          Fill="#94A3B8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="لا توجد حركات مسجلة بعد" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="ستظهر العمليات الأخيرة هنا فور تسجيلها بالمستودع" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
