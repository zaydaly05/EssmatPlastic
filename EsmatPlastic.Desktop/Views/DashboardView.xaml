<UserControl x:Class="EsmatPlastic.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Dashboard"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="Live overview of products and stock movements"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Content="↻  Refresh"
                    Style="{StaticResource SecondaryButton}"
                    Width="114"
                    Height="44"
                    HorizontalAlignment="Right"
                    Click="Refresh_Click"/>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="5">
            <Border x:Name="ProductsCard" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Products" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding ProductCount}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Total products" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="9" Background="{DynamicResource TealSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="◇" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="VariantsCard" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Variants" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding VariantCount}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Variants &amp; specifications" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="9" Background="{DynamicResource CanvasBrush}" VerticalAlignment="Center">
                        <TextBlock Text="◇" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="StockCard" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Current Stock" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding CurrentStock, StringFormat={}{0:N0}}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Total stored items" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="9" Background="{DynamicResource TealSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="▥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="TotalInCard" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total In" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding TotalIn, StringFormat={}{0:N0}}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Total incoming" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="9" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="⇩" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="TotalOutCard" Style="{StaticResource Card}" Padding="16" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Out" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="{Binding TotalOut, StringFormat={}{0:N0}}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Total outgoing" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="9" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="⇧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <Border x:Name="NoPermissionsPanel"
                Grid.Row="2"
                Grid.RowSpan="3"
                Panel.ZIndex="2"
                Style="{StaticResource Card}"
                Background="{DynamicResource CanvasBrush}"
                Visibility="Collapsed"
                Padding="28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="No permissions are assigned to this user"
                           FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Please contact your administrator to get the required access."
                           Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="▤  Recent Stock Activity" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Latest registered operations" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ListView Grid.Row="2" ItemsSource="{Binding RecentTransactions}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="8,10" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding TransactionTypeBg}" CornerRadius="12" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding TransactionTypeText}" Foreground="{Binding TransactionTypeColor}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding VariantName}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Quantity, Converter={StaticResource UnitFormatConverter}, ConverterParameter=Piece}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UserFullName}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="⚠  Low Stock Alerts" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource DangerSoftBrush}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} items}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="◉  System Operations Summary" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Product and inventory data is synchronized with the system API."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <Separator Background="{DynamicResource LineBrush}"/>
                        <TextBlock Text="•  Connection status:  Connected successfully"
                                   Foreground="{DynamicResource SuccessBrush}" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Text="•  Data is up to date"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
