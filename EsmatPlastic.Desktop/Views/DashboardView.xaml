<UserControl x:Class="EsmatPlastic.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">

            <StackPanel>

                <TextBlock Text="لوحة التحكم"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="نظرة عامة على بيانات النظام"
                           Foreground="#666666"
                           Margin="0,6,0,0"/>

            </StackPanel>

                <Button x:Name="RefreshButton"
                    Content="⟳  تحديث"
                    Width="110"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="Refresh_Click"/>

        </Grid>


        <UniformGrid Grid.Row="2"
                     Columns="5">

                <Border x:Name="ProductsCard"
                    Background="#E8F6F6"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,6,0">

                <StackPanel>
                    <TextBlock Text="المنتجات"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding ProductCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

                <Border x:Name="VariantsCard"
                    Background="#FFF1EC"
                    CornerRadius="10"
                    Padding="18"
                    Margin="6,0">

                <StackPanel>
                    <TextBlock Text="الأصناف"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding VariantCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

                <Border x:Name="StockCard"
                    Background="#EEF1FF"
                    CornerRadius="10"
                    Padding="18"
                    Margin="6,0">

                <StackPanel>
                    <TextBlock Text="المخزون الحالي"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding CurrentStock}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

                <Border x:Name="TotalInCard"
                    Background="#F2F8E9"
                    CornerRadius="10"
                    Padding="18"
                    Margin="6,0">

                <StackPanel>
                    <TextBlock Text="إجمالي الوارد"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding TotalIn}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

                <Border x:Name="TotalOutCard"
                    Background="#FFF7DE"
                    CornerRadius="10"
                    Padding="18"
                    Margin="6,0,0,0">

                <StackPanel>
                    <TextBlock Text="إجمالي الصادر"
                               Foreground="#666666"/>

                    <TextBlock Text="{Binding TotalOut}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Border>

        </UniformGrid>

        <Border x:Name="NoPermissionsPanel"
                Grid.Row="2"
                Background="#FFF7DE"
                CornerRadius="12"
                Padding="24"
                Visibility="Collapsed">

            <StackPanel>
                <TextBlock Text="لا توجد صلاحيات مرتبطة بهذا المستخدم"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#8A5A00"/>

                <TextBlock Text="يرجى تسجيل الخروج والتواصل مع مدير النظام لمنح الصلاحيات المناسبة."
                           Margin="0,8,0,0"
                           Foreground="#8A5A00"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>


        <Border Grid.Row="4"
                Background="White"
                CornerRadius="10"
                Padding="25">

            <StackPanel>

                <TextBlock Text="ملخص النظام"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text="يتم تحميل بيانات المنتجات والمخزون من واجهة API الخاصة بالنظام."
                           Margin="0,12,0,0"
                           Foreground="#666666"/>

                <TextBlock Text="يمكنك مراجعة الكميات والحركات من خلال الأقسام المتاحة."
                           Margin="0,8,0,0"
                           Foreground="#666666"/>

                <TextBlock Text="ستظهر الإحصاءات هنا بعد تحميل البيانات."
                           Margin="0,8,0,0"
                           Foreground="#666666"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
